# Plane REST API (self-hosted). NOTE: API is on :8000, not :3000 (3000 is the frontend SPA).
PLANE_BASE_URL=http://localhost:8000/api/v1
PLANE_API_TOKEN=plane_api_xxxxxxxxxxxxxxxxxxxxxxxx
PLANE_WORKSPACE_SLUG=css
# Optional: bot's own user id. If unset, resolved at startup via GET /users/me/.
PLANE_BOT_USER_ID=

# Webhook receiver (Plane in docker reaches host via host.docker.internal).
WEBHOOK_SECRET=
WEBHOOK_PORT=8787

# Codex runtime
PYTHON_BIN=/opt/homebrew/Caskroom/miniforge/base/bin/python
WORKFLOW_PATH=WORKFLOW.md
WORKSPACE_ROOT=.tmp/workspaces
